# FastAPI Backend Ortam Değişkenleri

# Ortam tipi: development | production
ENVIRONMENT=production

# İzin verilen CORS originleri (virgülle ayrılmış liste)
# Örnek: http://localhost:3000,https://oltasez.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://oltasez.vercel.app,*

# Sunucu çalışma portu
PORT=8000
